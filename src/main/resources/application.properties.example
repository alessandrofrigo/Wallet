# =====================================================================
# Template di configurazione.
# Copia questo file in "application.properties" (ignorato da git) e
# adatta i valori al tuo ambiente locale.
#   cp application.properties.example application.properties
# =====================================================================

# Spring DataSource Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/gestione_spese
spring.datasource.username=root
# In alternativa esporta la variabile d'ambiente DB_PASSWORD
spring.datasource.password=${DB_PASSWORD:changeme}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Inizializzazione automatica del database (crea le tabelle se mancanti)
spring.sql.init.mode=always
spring.sql.init.continue-on-error=false

# CORS Configuration - origini del frontend autorizzate
app.cors.allowed-origins=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Email (recupero password) - SMTP Gmail: usare una "password per le app" di Google,
# non la password normale dell'account (https://myaccount.google.com/apppasswords)
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=${MAIL_FROM:${MAIL_USERNAME:}}

# URL pubblico del frontend, usato per costruire il link nell'email di reset password
app.frontend-base-url=${FRONTEND_BASE_URL:http://localhost:8080}
